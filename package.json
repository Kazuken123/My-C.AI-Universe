{
  "name": "my-c.ai-universe",
  "version": "2.6.1",
  "description": "Full-featured OOP + Relational SQL Character.AI web application with Wiki ingestion, swipeable response variants, user personas, and hybrid long-term semantic memory.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/run-tests.js",
    "db:init": "node scripts/init-database.js",
    "db:turso:push": "node scripts/migrate-to-turso.js",
    "db:sync:stats": "node scripts/sync-real-stats.js",
    "db:assets:sync": "node scripts/migrate-media-assets.js",
    "setup-memory": "node scripts/setup-memory.js",
    "audit:pack": "node scripts/prepare-audit.js",
    "check": "node scripts/check-syntax.js",
    "test:unit": "node scripts/run-tests.js --unit",
    "test:api": "node scripts/run-tests.js --api",
    "eval:chat": "node scripts/eval/run-eval.mjs",
    "eval:rescore": "node scripts/eval/rescore.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@google/genai": "^1.34.0",
    "@libsql/client": "^0.18.0",
    "body-parser": "^2.2.1",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.0.16"
  },
  "keywords": [
    "character-ai",
    "oop",
    "sql",
    "sqlite",
    "roleplay",
    "gemini",
    "ollama"
  ],
  "license": "Apache-2.0"
}
