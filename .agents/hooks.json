{
  "repo-harness-gates": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/pre-commit-gate.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/stop-verify.mjs",
        "timeout": 30
      }
    ]
  }
}
