# Server Port
PORT=3000

# Default AI Provider: 'gemini' (primary) or 'ollama' (local)
AI_PROVIDER=gemini

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Local Ollama Configuration (optional fallback/alternative)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Python Memory Service Configuration (optional - Node.js hybrid memory works out of the box)
MEMORY_SERVICE_URL=http://localhost:5001

# Google OAuth 2.0 Client ID (Sign In with Google)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Authentication & Security
# Set a strong random secret key (required in production, e.g. on Render)
JWT_SECRET=your_super_secret_jwt_key_here

# Turso Cloud Database (LibSQL - Optional for local, recommended for Render/production)
# If omitted, the app will automatically use local SQLite (backend/db/universe.sqlite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Cloudflare R2 Object Storage (S3-compatible - 10GB free, $0 egress for avatars & media)
# If omitted, avatars are stored in local disk and Turso SQL media_assets table
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cai-universe-avatars
R2_PUBLIC_URL=


# Fish Audio & Voice Roleplay Engine
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
FISH_AUDIO_MODEL=s2.1-pro-free
GEMINI_TRANSLATION_MODEL=gemini-3.1-flash-lite
