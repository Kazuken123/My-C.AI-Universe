# Server Port
PORT=3000

# Default AI Provider: 'gemini' (primary) or 'ollama' (local)
AI_PROVIDER=gemini

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama Configuration (optional fallback/alternative)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Python Memory Service Configuration (optional - Node.js hybrid memory works out of the box)
MEMORY_SERVICE_URL=http://localhost:5001
